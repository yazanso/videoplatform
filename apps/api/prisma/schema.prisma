generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VideoVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum ReportReason {
  SPAM
  HARASSMENT
  NUDITY
  VIOLENCE
  MISINFORMATION
  COPYRIGHT
  OTHER
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  handle            String   @unique
  passwordHash      String
  displayName       String
  bio               String?
  avatarUrl         String?
  linkInBio         String?
  isBanned          Boolean  @default(false)
  shadowBanScore    Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  videos            Video[]
  likes             VideoLike[]
  followsGiven      Follow[] @relation("follower")
  followsReceived   Follow[] @relation("following")
  collections       Collection[]
}

model Video {
  id                    String          @id @default(cuid())
  creatorId             String
  title                 String
  description           String
  category              String
  tags                  String[]
  mediaUrl              String
  thumbnailUrl          String
  durationMs            Int
  visibility            VideoVisibility @default(PUBLIC)
  status                String          @default("PROCESSING")
  aiCaption             String?
  aiHashtags            String[]
  ctr                   Float           @default(0)
  completionRate        Float           @default(0)
  avgViewDurationMs     Float           @default(0)
  rewatchRate           Float           @default(0)
  engagementRate        Float           @default(0)
  saveRate              Float           @default(0)
  profileVisitRate      Float           @default(0)
  fastScrollRate        Float           @default(0)
  spamReportRate        Float           @default(0)
  rankingScore          Float           @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  creator               User            @relation(fields: [creatorId], references: [id])
  likes                 VideoLike[]
  comments              Comment[]
  metrics               VideoMetric[]
}

model VideoLike {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  video     Video    @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("follower", fields: [followerId], references: [id])
  following   User     @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Comment {
  id          String    @id @default(cuid())
  videoId     String
  authorId    String
  parentId    String?
  body        String
  likeCount   Int       @default(0)
  createdAt   DateTime  @default(now())

  video       Video     @relation(fields: [videoId], references: [id])
}

model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  owner       User     @relation(fields: [ownerId], references: [id])
}

model VideoMetric {
  id                    String   @id @default(cuid())
  videoId               String
  date                  DateTime
  impressions           Int      @default(0)
  plays                 Int      @default(0)
  uniqueViewers         Int      @default(0)
  watchTimeMs           BigInt   @default(0)
  avgViewDurationMs     Float    @default(0)
  completionRate        Float    @default(0)
  rewatchRate           Float    @default(0)
  likeCount             Int      @default(0)
  commentCount          Int      @default(0)
  shareCount            Int      @default(0)
  saveCount             Int      @default(0)

  video                 Video    @relation(fields: [videoId], references: [id])

  @@unique([videoId, date])
}

model Report {
  id          String       @id @default(cuid())
  videoId     String
  reporterId  String
  reason      ReportReason
  details     String?
  createdAt   DateTime     @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  type        String
  payload     Json
  readAt      DateTime?
  createdAt   DateTime @default(now())
}

model RevenueLedger {
  id            String   @id @default(cuid())
  creatorId     String
  videoId       String?
  eventType     String
  grossAmount   Decimal  @db.Decimal(10, 2)
  platformFee   Decimal  @db.Decimal(10, 2)
  netAmount     Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
}
